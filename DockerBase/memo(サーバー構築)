■ 1：MySQLにデータベースを読み込む
１：MySQLに入る（パスワード：p@ssword）
docker compose exec mysql mysql -u root -p --default-character-set=utf8mb4
 
２：カード強化サイトのデータを読み込む
source /root/sql/card_game.sql;
 
３：アイテム強化サイトのデータを読み込む
source /root/sql/forge_db.sql;
 
４：カード強化サイトの件数を確認（cards 9件 / user_cards 11件 / user_decks 3件）
USE card_game;
SELECT COUNT(*) FROM cards;
SELECT COUNT(*) FROM user_cards;
SELECT COUNT(*) FROM user_decks;
 
５：アイテム強化サイトの件数を確認（items 5件 / user_items 8件 / user_decks 1件）
USE forge_game;
SELECT COUNT(*) FROM items;
SELECT COUNT(*) FROM user_items;
SELECT COUNT(*) FROM user_decks;
 
６：MySQLから抜ける
exit
 
